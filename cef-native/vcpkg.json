    { "name": "nlohmann-json", "version": "3.12.0", "port-version": 2 },
    { "name": "sqlite3", "version": "3.53.4", "port-version": 0 },
    { "name": "openssl", "version": "3.6.3", "port-version": 0 }
  ]
}
