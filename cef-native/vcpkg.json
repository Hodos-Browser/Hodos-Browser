{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "hodos-browser-cef-native",
  "version-string": "0.4.0",
  "description": "C++ CEF shell native dependencies. DEP-1a: pins the vcpkg port set so a CEF/toolchain bump cannot silently drag in new C++ dependency versions.",
