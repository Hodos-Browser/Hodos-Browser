<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- CEF V8 JIT requires this -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Loading CEF framework -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- JavaScript JIT compilation -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Camera access for websites (e.g. video calls) -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <!-- Microphone access for websites (e.g. video calls, voice recording) -->
    <key>com.apple.security.device.microphone</key>
    <true/>
    <!-- ⚠️ device.microphone above is the App SANDBOX key and does NOT satisfy the
         hardened-runtime TCC policy. A hardened-runtime app (release.yml signs with
         the "options runtime" codesign flag) needs device.audio-input, or tccd refuses
         to even show the mic prompt and Chromium delivers a silent all-zero track
         (beta.3 §B1 diagnosis, 2026-08-18). Keep BOTH keys: the sandbox key is
         harmless, audio-input is load-bearing.

         ⛔ NEVER write a literal double-hyphen inside a comment in this file. It is
         illegal XML, `plutil -lint` accepts it anyway, and codesign's much stricter
         AMFIUnserializeXML rejects the WHOLE file with
             "Failed to parse entitlements: AMFIUnserializeXML: syntax error near line N"
         which leaves every macOS bundle UNSIGNED — dev builds SIGKILL (exit 137) and
         release.yml's six signing steps fail. Measured 2026-08-26: this exact mistake
         shipped in 33722d0 and broke macOS signing for eight days. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
