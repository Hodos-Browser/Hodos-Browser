/staging/
/dist/
/installer/Output/

# CEF binaries backup (large, not for git)
# Engine backups. The suffixed form (-g<forksha>) is what we actually create — the
# bare name never matched them, so 1.3 GB of CEF distributions sat untracked in the
# working tree where a stray `git add -A` could have committed them.
/cef-binaries-backup/
/cef-binaries-backup-*/

# Claude session logs
/sessions/
